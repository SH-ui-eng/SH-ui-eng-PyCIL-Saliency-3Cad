{
    "model_name": "ds-al",
    "prefix": "DS-AL",
    "memory_size": 0,

    "dataset": "3cad",
    "seed": [1993],
    "shuffle": false,
    "device": ["0"],

    "convnet_type": "resnet18",
    "init_cls": 3,
    "increment": 2,

    "num_workers": 16,
    "init_batch_size": 128,
    "IL_batch_size": 4096,
    "inplace_repeat": 1,

    "configurations": {
        "3cad": {
            "buffer_size": 1024,
            "gamma": 0.1,
            "gamma_comp": 0.1,
            "compensation_ratio": 0.6,
            "init_weight_decay": 5e-4,
            "scheduler": {
                "type": "MultiStep",
                "init_lr": 0.1,
                "init_epochs": 160,
                "warmup": 0,
                "milestones": [120, 140],
                "decay": 0.1
            }
        },
        "imagenet1000": {
            "buffer_size": 16384,
            "gamma": 0.1,
            "gamma_comp": 0.1,
            "compensation_ratio": 1.5,
            "init_weight_decay": 5e-5,
            "scheduler": {
                "type": "MultiStep",
                "init_lr": 0.1,
                "init_epochs": 90,
                "warmup": 0,
                "milestones": [30, 60],
                "decay": 0.1
            }
        }
    }
}
